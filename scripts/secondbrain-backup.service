[Unit]
Description=SecondBrain off-box backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/secondbrain-backup.env
ExecStart=/usr/local/bin/secondbrain-backup backup
# Verify weekly rather than nightly: a restore drill is expensive but a backup
# nobody has restored is theatre.
Nice=10
IOSchedulingClass=idle
