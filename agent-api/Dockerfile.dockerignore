# BuildKit reads <Dockerfile>.dockerignore for a root-context build: send
# only what the agent-api image needs (the frozen workspace lock needs every
# member's pyproject.toml).
*
!pyproject.toml
!uv.lock
!harness/pyproject.toml
!harness/protocol
!harness/guest
!harness/image/versions.env
!flows/pyproject.toml
!flows/flows
!agent-api/pyproject.toml
!agent-api/app
!mcp-gateway/pyproject.toml
flows/flows/tests
**/__pycache__
**/*.pyc
**/.venv
**/.pytest_cache
