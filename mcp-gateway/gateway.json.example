{
  "_comment": "Copy to mcp-gateway/data/gateway.json (gitignored, chmod 600) and restart mcp-gateway. Generate from agent-api's tenants.json with: cd mcp-gateway && uv run python -m app.migrate_config ../agent-api/data/tenants.json > data/gateway.json. See harness/docs/GATEWAY.md.",
  "upstreams": {
    "wcc-events": {
      "url": "http://host.docker.internal:8765/mcp/events",
      "auth_token": "<must match WCC_MCP_TOKEN_EVENTS on the MCP server>",
      "timeout_s": 2700,
      "tool_defs_ttl_s": 300,
      "allow_private": true
    },
    "wcc-mentorship": {
      "url": "http://host.docker.internal:8765/mcp/mentorship",
      "auth_token": "<must match WCC_MCP_TOKEN_MENTORSHIP>",
      "timeout_s": 600,
      "allow_private": true
    },
    "wcc-analytic": {
      "url": "http://host.docker.internal:8765/mcp/analytic",
      "auth_token": "<must match WCC_MCP_TOKEN_ANALYTIC>",
      "timeout_s": 1200,
      "allow_private": true
    },
    "code-index": {
      "url": "http://host.docker.internal:8770/mcp",
      "auth_token": "<must match CODE_INDEX_TOKEN on the code-index server>",
      "timeout_s": 600,
      "allow_private": true
    }
  },
  "tenants": {
    "default": {"upstreams": ["wcc-events", "wcc-mentorship", "wcc-analytic", "code-index"], "allow": ["*"], "deny": [], "promoted": [], "max_concurrent": 2}
  },
  "input_expires_s": 3600
}
