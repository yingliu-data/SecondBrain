# Pinned versions for the guest VM image (harness/image/build.sh reads this).
# Change a pin here, then `make image` on the server; nothing else refers to versions.

# Firecracker release (host binary). Tarball sha256 from the release's .sha256.txt.
FIRECRACKER_VERSION=v1.17.0
FIRECRACKER_URL=https://github.com/firecracker-microvm/firecracker/releases/download/v1.17.0/firecracker-v1.17.0-x86_64.tgz
FIRECRACKER_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558

# Guest kernel: the Firecracker CI kernel (uncompressed vmlinux, x86_64) from the
# public spec.ccfc.min bucket. Path pattern: firecracker-ci/<ci-tag>/<arch>/vmlinux-<ver>.
# CONFIG_VIRTIO_VSOCKETS=y, VIRTIO_BLK=y, EXT4_FS=y, TMPFS=y, MAGIC_SYSRQ=y (its .config
# sits next to it: <KERNEL_URL>.config). The v1.15 CI tag is the newest tag-named
# artifact set; newer sets are date-named (firecracker-ci/YYYYMMDD-<sha>-0/) and roll.
KERNEL_CI_TAG=v1.15
KERNEL_VERSION=6.1.155
KERNEL_URL=https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.15/x86_64/vmlinux-6.1.155
KERNEL_SHA256=e20e46d0c36c55c0d1014eb20576171b3f3d922260d9f792017aeff53af3d4f2

# Rootfs base image (Debian bookworm-slim with Python 3.12 from the official image).
ROOTFS_BASE_IMAGE=python:3.12-slim-bookworm

# Sizes (MiB). ROOTFS_MIB=0 means "measured: du + 25% + 64".
ROOTFS_MIB=0
WORKSPACE_TEMPLATE_MIB=1024
